                                        <div class="quiz-item mt-2" data-index="@i" data-group="@(group + 3)">
                                            <input type="hidden" name="Quizzes[@i].QuizId" value="@(quiz?.QuizId ?? 0)" />
                                            <input type="hidden" name="Quizzes[@i].LessonId" value="@Model.LessonId" />
                                            <input type="hidden" name="Quizzes[@i].ImageGroup" value="Part7Group@(group + 3)" />
                                            <div class="row g-2">
                                                <div class="col-12">
                                                    <label class="form-label fw-bold text-success">Câu @(i + 1)</label>
                                                    <input name="Quizzes[@i].Question" class="form-control" value="@(quiz?.Question ?? "")" placeholder="Câu hỏi..." />
