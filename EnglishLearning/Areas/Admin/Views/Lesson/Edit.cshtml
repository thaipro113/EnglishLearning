<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let quizIndex = @(Model.LessonType == "TOEIC" ? 0 : Model.Quizzes.Count - 1);

        function addQuiz() {
            quizIndex++;
            const container = document.getElementById("quiz-list");
            const html = `
                        <div class="quiz-item" data-index="${quizIndex}">
                            <input type="hidden" name="Quizzes[${quizIndex}].QuizId" value="0" />
                            <input type="hidden" name="Quizzes[${quizIndex}].LessonId" value="@Model.LessonId" />
                            <input type="hidden" name="Quizzes[${quizIndex}].IsDeleted" value="false" />
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label fw-bold text-success">Câu ${quizIndex + 1}</label>
                                    <input name="Quizzes[${quizIndex}].Question" class="form-control" required />
                                </div>
                                <div class="col-md-6"><label>A</label><input name="Quizzes[${quizIndex}].OptionA" class="form-control" required /></div>
                                <div class="col-md-6"><label>B</label><input name="Quizzes[${quizIndex}].OptionB" class="form-control" required /></div>
                                <div class="col-md-6"><label>C</label><input name="Quizzes[${quizIndex}].OptionC" class="form-control" required /></div>
                                <div class="col-md-6"><label>D</label><input name="Quizzes[${quizIndex}].OptionD" class="form-control" required /></div>
                                <div class="col-12">
                                    <label class="text-danger">Đáp án đúng</label>
                                    <input name="Quizzes[${quizIndex}].CorrectAnswer" class="form-control" maxlength="1" style="text-transform:uppercase" required />
                                </div>
                            </div>
                            <button type="button" class="remove-btn" onclick="removeQuiz(this)">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>`;
            container.insertAdjacentHTML("beforeend", html);
        }

        function removeQuiz(btn) {
            const item = btn.closest(".quiz-item");
            const del = item.querySelector("input[name*='IsDeleted']");
            if (del) del.value = "true";
            item.style.display = "none";
        }

        // Script cho Part 7 (147-163) - Thêm nhóm hình động
        let currentQuestion = 146; // Bắt đầu từ câu 147 (index 146)
        const maxQuestion = 163;   // Câu 163 (index 162)
        let groupCounter = 0;

        // Tính toán currentQuestion và groupCounter dựa trên các nhóm đã có
        document.addEventListener('DOMContentLoaded', function () {
            const container = document.getElementById('part7-147-163-container');
            if (container) {
                const existingGroups = container.querySelectorAll('[data-group-index]');
                existingGroups.forEach(group => {
                    const groupIndex = parseInt(group.getAttribute('data-group-index'));
                    if (groupIndex >= groupCounter) {
                        groupCounter = groupIndex + 1;
                    }

                    // Tìm các input có name chứa QuizId để xác định index
                    const quizInputs = group.querySelectorAll('input[name*="Quizzes["]');
                    quizInputs.forEach(input => {
                        const match = input.name.match(/Quizzes\[(\d+)\]/);
                        if (match) {
                            const idx = parseInt(match[1]);
                            if (idx >= 146 && idx < 163 && idx >= currentQuestion) {
                                currentQuestion = idx + 1;
                            }
                        }
                    });
                });
            }
        });

        function addPart7Group() {
            if (currentQuestion >= maxQuestion) {
                alert("Đã hết câu hỏi cho phần này (147–163).");
                return;
            }

            // Hỏi admin muốn nhóm này có bao nhiêu câu
            let numQuestions = parseInt(prompt("Nhóm này có bao nhiêu câu? (2 hoặc 3)", "2"));
            if (![2, 3].includes(numQuestions)) {
                alert("Chỉ được chọn 2 hoặc 3 câu.");
                return;
            }

            const groupStart = currentQuestion + 1;
            const groupEnd = Math.min(currentQuestion + numQuestions, maxQuestion);

            let html = `
                        <div class="quiz-item border rounded p-3 mb-3 bg-light" data-group-index="${groupCounter}">
                            <label class="form-label fw-bold text-primary">Nhóm câu ${groupStart} - ${groupEnd} (1 hình)</label>
                            <input type="file" name="Part7Images_GroupDynamic[${groupCounter}]" accept="image/*" class="form-control mb-3" required />
                    `;

            for (let q = groupStart; q <= groupEnd; q++) {
                const quizIndex = q - 1; // Index trong mảng (0-based)
                html += `
                            <div class="border rounded p-3 mb-2 bg-white">
                                <label class="form-label fw-bold text-success">Câu ${q}</label>
                                <input type="hidden" name="Quizzes[${quizIndex}].QuizId" value="0" />
                                <input type="hidden" name="Quizzes[${quizIndex}].LessonId" value="@Model.LessonId" />
                                <input type="hidden" name="Quizzes[${quizIndex}].Question" value="Part 7 - Question ${q}" />
                                <input type="hidden" name="Quizzes[${quizIndex}].ImageGroup" value="Part7GroupDynamic${groupCounter}" />
                                <div class="row g-2">
                                    <div class="col-md-6"><label>A</label><input name="Quizzes[${quizIndex}].OptionA" class="form-control" /></div>
                                    <div class="col-md-6"><label>B</label><input name="Quizzes[${quizIndex}].OptionB" class="form-control" /></div>
                                    <div class="col-md-6"><label>C</label><input name="Quizzes[${quizIndex}].OptionC" class="form-control" /></div>
                                    <div class="col-md-6"><label>D</label><input name="Quizzes[${quizIndex}].OptionD" class="form-control" /></div>
                                    <div class="col-12">
                                        <label class="text-danger">Đáp án đúng</label>
                                        <input name="Quizzes[${quizIndex}].CorrectAnswer" class="form-control" maxlength="1" style="text-transform:uppercase" value="A" />
                                    </div>
                                </div>
                            </div>
                        `;
            }

            html += `</div>`;
            document.getElementById("part7-147-163-container").insertAdjacentHTML("beforeend", html);

            currentQuestion += numQuestions;
            groupCounter++;

            // Ẩn nút nếu đã hết câu
            if (currentQuestion >= maxQuestion) {
                document.getElementById('addPart7GroupBtn').style.display = 'none';
            }
        }
    </script>
}