                                                dynamicGroupCounter++;
                                            }
                                            currentImgPath = imgPath;
                                            groupStart = i;
                                        }
                                    }
                                    else
                                    {
                                        // Kết thúc nhóm nếu gặp câu không có ImagePath
                                        if (currentImgPath != null && groupStart >= 0)
                                        {
                                            int groupEnd = i - 1;
                                            <div class="quiz-item border rounded p-3 mb-3 bg-light" data-group-index="@dynamicGroupCounter">
