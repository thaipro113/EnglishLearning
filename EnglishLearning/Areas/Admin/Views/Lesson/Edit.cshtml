                                                <div class="col-md-6"><label>A</label><input name="Quizzes[@i].OptionA" class="form-control" value="@(quiz?.OptionA ?? "")" /></div>
                                                <div class="col-md-6"><label>B</label><input name="Quizzes[@i].OptionB" class="form-control" value="@(quiz?.OptionB ?? "")" /></div>
                                                <div class="col-md-6"><label>C</label><input name="Quizzes[@i].OptionC" class="form-control" value="@(quiz?.OptionC ?? "")" /></div>
