@model List<Quiz>
@{
    ViewBag.Title = "Kết quả làm bài";
    Layout = "~/Views/Shared/TopFoot.cshtml";
    int totalQuestions = ViewBag.TotalQuestions ?? Model.Count;
    string lessonType = ViewBag.LessonType?.ToString() ?? "Normal";
    double scorePercentage = lessonType == "TOEIC"
        ? (double)(int)(ViewBag.Score ?? 0) / 200 * 990
        : (double)(int)(ViewBag.Score ?? 0) / totalQuestions * 10;
}


<link href="~/css/result.css" rel="stylesheet" />
<div class="result-container">
    <div class="result-header">
        <h2 class="result-title">Hoàn thành bài kiểm tra</h2>
    </div>

    <!-- ĐIỂM SỐ -->
    <div class="score-box">
        <div class="score-text">Kết quả làm bài</div>
        <div class="score-number"><strong>@scorePercentage.ToString("F1") / @(lessonType == "TOEIC" ? "990" : "10")</strong></div>
        <div class="score-detail">
            <strong>@(ViewBag.Score ?? 0)</strong> | @totalQuestions câu đúng
        </div>
    </div>

    <!-- BỐ CỤC 2 CỘT -->
    <div class="result-body">
        <!-- TRÁI: SƠ ĐỒ CÂU HỎI -->
        <div class="sidebar">
            <h5 style="text-align:center; margin-bottom:10px;">Sơ đồ câu hỏi</h5>
            <div class="question-grid" id="resultGrid"></div>
            <div class="text-center">
                <a asp-controller="Course" asp-action="Details" asp-route-id="@ViewBag.CourseId" class="back-btn">
                    Quay lại khóa học
                </a>
            </div>
        </div>

        <!-- PHẢI: DANH SÁCH CÂU HỎI -->
        <div class="result-content">
            <div id="resultsList">
                @if (Model != null && Model.Any())
                {
                    for (int i = 0; i < Model.Count; i++)
                    {
                        var quiz = Model[i];
                        var userAnswer = ViewBag.UserAnswers?[quiz.QuizId]?.ToString();
                        var isCorrect = userAnswer == quiz.CorrectAnswer;

                        <div class="result-item @(isCorrect ? "correct" : "incorrect")" id="result-item-@(i)">
                            <div class="question-title">Câu @(i + 1): @quiz.Question</div>
                            @foreach (var opt in new[] { "A", "B", "C", "D" })
                            {
                                var optVal = quiz.GetType().GetProperty($"Option{opt}")?.GetValue(quiz)?.ToString();
                                if (!string.IsNullOrEmpty(optVal))
                                {
                                    var isUser = userAnswer == opt;
                                    var isRight = opt == quiz.CorrectAnswer;

                                    <div class="option-line
                                    @(isRight ? "correct-answer" : "")
                                    @(isUser && !isRight ? "incorrect-answer" : "")">

                                        <strong>@opt.</strong> @optVal

                                        @if (isRight && !isCorrect)
                                        {
                                            <span class="correct-answer"> (Đáp án đúng)</span>
                                        }
                                        @if (isUser && !isRight)
                                        {
                                            <span class="incorrect-answer"></span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // === DỮ LIỆU TỪ SERVER ===
        const totalQuestions = @totalQuestions;
        const userAnswers = @Html.Raw(Json.Serialize(ViewBag.UserAnswers ?? new { }));
        const correctAnswers = @Html.Raw(Json.Serialize(Model.ToDictionary(q => q.QuizId, q => q.CorrectAnswer)));

        // Tạo mảng QuizId theo thứ tự
        const quizIds = [
            @for (int i = 0; i < Model.Count; i++)
            {
                @Model[i].QuizId
                if (i < Model.Count - 1) { <text>,</text> }
            }
        ];

        // === TẠO GRID + CLICK TO SCROLL ===
        const grid = document.getElementById('resultGrid');
        for (let i = 0; i < totalQuestions; i++) {
            const quizId = quizIds[i];
            const userAnswer = userAnswers[quizId];
            const correctAnswer = correctAnswers[quizId];
            const isCorrect = userAnswer === correctAnswer;

            const btn = document.createElement('div');
            btn.className = `q-number ${isCorrect ? 'correct' : 'incorrect'}`;
            btn.textContent = i + 1;
            btn.title = isCorrect ? 'Đúng' : 'Sai';

            btn.onclick = () => {
                const target = document.getElementById(`result-item-${i}`);
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    target.classList.add('highlight');
                    setTimeout(() => target.classList.remove('highlight'), 800);
                }
            };

            grid.appendChild(btn);
        }

        // === HIỆU ỨNG ĐẾM SỐ CÂU ĐÚNG ===
        const scoreDetail = document.querySelector('.score-detail strong');
        if (scoreDetail) {
            let current = 0;
            const target = @(ViewBag.Score ?? 0);
            const interval = setInterval(() => {
                if (current < target) {
                    current++;
                    scoreDetail.textContent = current + ' / ' + totalQuestions;
                } else {
                    clearInterval(interval);
                }
            }, 40);
        }
    </script>
}