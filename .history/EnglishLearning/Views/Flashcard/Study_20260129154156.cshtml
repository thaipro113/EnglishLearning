@model EnglishLearning.Models.FlashcardSet

@{
    ViewData["Title"] = "Học Flashcard: " + Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .flashcard-container {
        perspective: 1000px;
        height: 400px;
        cursor: pointer;
    }

    .flashcard {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s;
    }

    .flashcard.flipped {
        transform: rotateY(180deg);
    }

    .flashcard-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        padding: 20px;
        text-align: center;
        font-size: 2rem; /* Initial font size */
        overflow: hidden; /* Ensure text doesn't overflow */
    }

    .flashcard-front {
        background: linear-gradient(135deg, #ffffff, #f0f7ff);
        color: #1e3a8a;
    }

    .flashcard-back {
        background: linear-gradient(135deg, #3b82f6, #1e40af);
        color: white;
        transform: rotateY(180deg);
    }

    .controls {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
    }

    .progress-bar-custom {
        height: 10px;
        background-color: #e9ecef;
        border-radius: 5px;
        margin-bottom: 20px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background-color: #3b82f6;
        transition: width 0.3s ease;
    }
</style>

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a asp-action="Index" class="text-secondary mb-2 d-inline-block"><i class="fas fa-arrow-left"></i> Quay lại danh sách</a>
                <h2 class="display-5">@Model.Title</h2>
            </div>
            <div class="text-muted">
                <span id="currentIndex">1</span> / <span id="totalCards">@Model.Flashcards.Count</span>
            </div>
        </div>

        <div class="progress-bar-custom">
            <div class="progress-fill" id="progressBar" style="width: 0%"></div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                @if (Model.Flashcards.Count > 0)
                {
                    <div class="flashcard-container" onclick="flipCard()">
                        <div class="flashcard" id="flashcard">
                            <div class="flashcard-face flashcard-front">
                                <span id="frontText"></span>
                            </div>
                            <div class="flashcard-face flashcard-back">
                                <span id="backText"></span>
                            </div>
                        </div>
                    </div>

                    <div class="controls">
                        <button class="btn btn-outline-primary btn-lg rounded-circle" onclick="prevCard()" id="prevBtn" disabled>
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button class="btn btn-outline-primary btn-lg rounded-circle" onclick="nextCard()" id="nextBtn">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                }
                else
                {
                    <div class="text-center p-5 bg-white rounded shadow-sm">
                        <i class="fas fa-layer-group fa-3x text-muted mb-3"></i>
                        <p class="lead">Bộ này chưa có thẻ nào.</p>
                        <a asp-action="Index" class="btn btn-primary">Quay lại</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var cards = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Flashcards.Select(c => new { c.FrontText, c.BackText })));
        var currentIndex = 0;
        var isFlipped = false;

         // Helper function to adjust font size dynamically
        function adjustFontSize(element) {
            const maxFontSize = 32; // Maximum font size in px
            const minFontSize = 16; // Minimum font size in px
            const maxLength = 200; // Character count at which we hit minFontSize
            const textLength = element.innerText.length;

            if (textLength === 0) return;

             // Linear interpolation between max and min font size
            let newSize = maxFontSize - ((textLength / maxLength) * (maxFontSize - minFontSize));
            
            // Clamp value
            newSize = Math.max(minFontSize, Math.min(newSize, maxFontSize));
            
            element.style.fontSize = newSize + 'px';
        }


        function updateCard() {
            if (cards.length === 0) return;

            var card = cards[currentIndex];
            var frontEl = document.getElementById('frontText');
            var backEl = document.getElementById('backText');

            frontEl.innerText = card.FrontText;
            backEl.innerText = card.BackText;

            // Adjust font size for both faces
            adjustFontSize(frontEl);
            adjustFontSize(backEl);

            document.getElementById('currentIndex').innerText = currentIndex + 1;
            document.getElementById('totalCards').innerText = cards.length;
            
            var progress = ((currentIndex + 1) / cards.length) * 100;
            document.getElementById('progressBar').style.width = progress + '%';

            document.getElementById('prevBtn').disabled = currentIndex === 0;
            document.getElementById('nextBtn').disabled = currentIndex === cards.length - 1;
            
            // Reset flip
            var flashcard = document.getElementById('flashcard');
            flashcard.classList.remove('flipped');
            isFlipped = false;
        }

        function flipCard() {
            var flashcard = document.getElementById('flashcard');
            flashcard.classList.toggle('flipped');
            isFlipped = !isFlipped;
        }

        function nextCard() {
            if (currentIndex < cards.length - 1) {
                currentIndex++;
                updateCard();
            }
        }

        function prevCard() {
            if (currentIndex > 0) {
                currentIndex--;
                updateCard();
            }
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            if (cards.length > 0) {
                updateCard();
            }
            
            // Keyboard navigation
            document.addEventListener('keydown', function(event) {
                if (event.code === 'Space' || event.code === 'Enter') {
                    flipCard();
                    event.preventDefault();
                } else if (event.code === 'ArrowRight') {
                    nextCard();
                } else if (event.code === 'ArrowLeft') {
                    prevCard();
                }
            });
        });
    </script>
}
