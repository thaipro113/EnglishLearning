@model IEnumerable<EnglishLearning.Models.FlashcardSet>

@{
    ViewData["Title"] = "Quản lý Flashcard";
    Layout = "~/Areas/Admin/Views/Shared/Temp.cshtml";
}

<div class="container-fluid">
    <h1 class="h3 mb-2 text-gray-800">Quản lý Flashcard Sets</h1>
    <p class="mb-4">Quản lý các bộ thẻ ghi nhớ cho người dùng.</p>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách bộ thẻ</h6>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Tạo mới
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tiêu đề</th>
                            <th>Mô tả</th>
                            <th>Số lượng thẻ</th>
                            <th>Ngày tạo</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.FlashcardSetId</td>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>@item.Flashcards.Count</td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a asp-action="ManageCards" asp-route-id="@item.FlashcardSetId" class="btn btn-info btn-sm" title="Quản lý thẻ">
                                        <i class="fas fa-list"></i> Thẻ
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.FlashcardSetId" class="btn btn-warning btn-sm" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.FlashcardSetId" class="btn btn-danger btn-sm" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
